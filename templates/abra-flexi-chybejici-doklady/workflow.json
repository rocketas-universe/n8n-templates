    {
      "parameters": {
        "jsCode": "const rowCount = $input.first().json.winstrom[\"@rowCount\"];\nconst pageSize = 5000;\nconst totalPages = Math.ceil(rowCount / pageSize);\n\n// Přeneseme client_name z Config Variables\nconst clientName = $('Config Variables').first().json.client_name;\n\nconst pages = [];\nfor (let i = 0; i < totalPages; i++) {\n  pages.push({\n    json: {\n      pageNumber: i,\n      start: i * pageSize,\n      limit: pageSize,\n      totalRows: rowCount,\n      totalPages: totalPages,\n      client_name: clientName\n    }\n  });\n}\n\nreturn pages;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        0
      ],
      "id": "7b83394f-f487-4922-91a5-5885b9deb893",
      "name": "GeneratePages"
    },
    {
      "parameters": {
        "url": "=https://VASE-INSTACE.flexibee.eu/c/{{ $json.client_name }}/banka/(protiUcet='code:395001').json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "={{ $json.limit }}"
            },
            {
              "name": "start",
              "value": "={{ $json.start }}"
            },
            {
              "name": "detail",
              "value": "custom:kod,typPohybuK,varSym,datVyst,popis,sumCelkem,sumCelkemMen,zuctovano,vazby,castka,typVazbyK,buc,banka,primUcet,bic,specSym,protiUcet,nazFirmy"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1072,
        0
      ],
      "id": "c2dd48bc-2a58-4a3e-a41e-8f5d4dce73f5",
      "name": "Flexi - Fetch Page",
      "credentials": {
        "httpBasicAuth": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allRecords = [];\n\nfor (const item of $input.all()) {\n  const bankaArray = item.json.winstrom?.banka || [];\n  \n  for (const row of bankaArray) {\n    allRecords.push({\n      json: {\n        kod: row.kod || '',\n        typPohybuK: row['typPohybuK@showAs'] || row.typPohybuK || '',\n        varSym: row.varSym || '',\n        datVyst: row.datVyst || '',\n        popis: row.popis || '',\n        sumCelkem: row.sumCelkem || 0,\n        sumCelkemMen: row.sumCelkemMen || '',\n        zuctovano: row.zuctovano || '',\n        castka: row.castka || 0,\n        buc: row.buc || '',\n        banka: row['banka@showAs'] || row.banka || '',\n        primUcet: row['primUcet@showAs'] || row.primUcet || '',\n        bic: row.bic || '',\n        specSym: row.specSym || '',\n        protiUcet: row['protiUcet@showAs'] || row.protiUcet || '',\n        nazFirmy: row.nazFirmy || ''\n      }\n    });\n  }\n}\n\nreturn allRecords;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        0
      ],
      "id": "dd5780de-9fbe-4648-8ac4-1e662c78c170",
      "name": "transform_data"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  \n  // Parsování datumu - z \"2025-08-06+02:00\" na \"6.8.2025\"\n  let datumFormatted = '';\n  if (row.datVyst) {\n    const datePart = row.datVyst.split('+')[0].split('T')[0];\n    const [year, month, day] = datePart.split('-');\n    datumFormatted = `${parseInt(day)}.${parseInt(month)}.${year}`;\n  }\n  \n  // Částka CZK - absolutní hodnota jako číslo\n  const castkaCZK = Math.abs(parseFloat(row.sumCelkem) || 0);\n  \n  // Částka v měně\n  const castkaMena = Math.abs(parseFloat(row.sumCelkemMen) || 0);\n  \n  // Extrakce dodavatele z popisu\n  let dodavatel = row.nazFirmy || '';\n  if (!dodavatel && row.popis) {\n    const popis = row.popis;\n    \n    // Rozdělíme podle středníků\n    const parts = popis.split(';');\n    \n    // První část obsahuje \"Platba kartou PK: XXXX text\"\n    if (parts.length > 0) {\n      // Odstraníme prefix \"Platba kartou PK: ČÍSLO_KARTY\"\n      let firstPart = parts[0].replace(/Platba kartou PK:\\s*\\d+X+\\d*\\s*/i, '').trim();\n      \n      // Pokud první část vypadá jako částka (číslo + měna), vezmi druhou část\n      if (/^\\d+[,.]?\\d*\\s*(USD|EUR|CZK|GBP)$/i.test(firstPart)) {\n        dodavatel = parts.length > 1 ? parts[1].trim() : firstPart;\n      } else {\n        dodavatel = firstPart;\n      }\n    }\n  }\n  \n  results.push({\n    json: {\n      'Datum transakce': datumFormatted,\n      'Castka CZK': castkaCZK,\n      'Castka v mene': castkaMena,\n      'Variabilni symbol': row.varSym || '',\n      'Dodavatel sluzby': dodavatel,\n      'Popis transakce': row.popis || '',\n      'Odpovedna osoba': ''\n    }\n  });\n}\n\n// Seřadit podle částky od největší po nejmenší\nresults.sort((a, b) => b.json['Castka CZK'] - a.json['Castka CZK']);\n\nreturn results;"
      },
